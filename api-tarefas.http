@baseUrl = http://localhost:8080
@projetoId = 1
@responsavelId = 1
@tarefaId = 1

### RF01 - Cadastrar projeto
POST {{baseUrl}}/projetos
Content-Type: application/json

{
  "nome": "Projeto Web",
  "descricao": "Atividade de Programação Web Backend"
}

### RF02 - Listar projetos
GET {{baseUrl}}/projetos

### Consultar projeto pelo id
GET {{baseUrl}}/projetos/{{projetoId}}

### RF12 - Projeto inexistente deve retornar 404
GET {{baseUrl}}/projetos/99999

### Atualizar projeto
PUT {{baseUrl}}/projetos/{{projetoId}}
Content-Type: application/json

{
  "nome": "Projeto Web Atualizado",
  "descricao": "Descrição nova do projeto"
}

### RF03 - Cadastrar responsável
POST {{baseUrl}}/responsaveis
Content-Type: application/json

{
  "nome": "Igor Lima",
  "email": "igor@email.com"
}

### RF04 - Listar responsáveis
GET {{baseUrl}}/responsaveis

### Consultar responsável pelo id
GET {{baseUrl}}/responsaveis/{{responsavelId}}

### Atualizar responsável
PUT {{baseUrl}}/responsaveis/{{responsavelId}}
Content-Type: application/json

{
  "nome": "Igor Lima Silva",
  "email": "igor.silva@email.com"
}

### RF05 - Cadastrar tarefa (status NOVA e data de criação pelo sistema)
POST {{baseUrl}}/tarefas
Content-Type: application/json

{
  "titulo": "Montar relatório",
  "descricao": "Relatório semanal do projeto",
  "prioridade": "ALTA",
  "prazo": "2026-09-25",
  "projetoId": 1,
  "responsavelId": 1
}

### RF06 - Listar todas as tarefas
GET {{baseUrl}}/tarefas

### RF07 - Filtrar tarefas por status
GET {{baseUrl}}/tarefas?status=NOVA

### RF07 - Filtrar tarefas por status e projeto
GET {{baseUrl}}/tarefas?status=NOVA&projetoId=1

### RF08 - Consultar tarefa pelo id
GET {{baseUrl}}/tarefas/{{tarefaId}}

### RF12 - Tarefa inexistente deve retornar 404
GET {{baseUrl}}/tarefas/99999

### RF09 - Atualizar tarefa (troca de status e responsável)
PUT {{baseUrl}}/tarefas/{{tarefaId}}
Content-Type: application/json

{
  "titulo": "Montar relatório",
  "descricao": "Relatório semanal do projeto",
  "status": "EM_ANDAMENTO",
  "prioridade": "ALTA",
  "prazo": "2026-09-25",
  "projetoId": 1,
  "responsavelId": 1
}

### Cancelar tarefa
PUT {{baseUrl}}/tarefas/{{tarefaId}}
Content-Type: application/json

{
  "titulo": "Montar relatório",
  "descricao": "Relatório semanal do projeto",
  "status": "CANCELADA",
  "prioridade": "ALTA",
  "prazo": "2026-09-25",
  "projetoId": 1,
  "responsavelId": 1
}

### RF11 - Concluir tarefa (preenche concluida_em automaticamente)
PUT {{baseUrl}}/tarefas/{{tarefaId}}
Content-Type: application/json

{
  "titulo": "Montar relatório",
  "descricao": "Relatório semanal do projeto",
  "status": "CONCLUIDA",
  "prioridade": "ALTA",
  "prazo": "2026-09-25",
  "projetoId": 1,
  "responsavelId": 1
}

### RF10 - Remover tarefa
DELETE {{baseUrl}}/tarefas/{{tarefaId}}

### Remover responsável
DELETE {{baseUrl}}/responsaveis/{{responsavelId}}

### Remover projeto
DELETE {{baseUrl}}/projetos/{{projetoId}}
